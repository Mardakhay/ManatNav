{
  "name": "ManatNav — AZN Smart Dashboard",
  "short_name": "ManatNav",
  "description": "An AZN-focused currency and international shopping dashboard.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f6f7f3",
  "theme_color": "#f6f7f3",
  "categories": ["finance", "shopping", "utilities"],
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Currency converter",
      "short_name": "Convert",
      "description": "Open the shopping cost converter",
      "url": "/?tool=converter"
    },
    {
      "name": "Exchange rate history",
      "short_name": "History",
      "description": "View historical exchange rate charts",
      "url": "/?tool=history"
    }
  ]
}
